{
  "name": "@damomoashidamomo/dsh-kiro",
  "version": "0.1.0",
  "description": "Kiro-CLI equivalent TUI bundle for DeepSeek Harness — rich terminal UI with markdown rendering, slash commands, custom agents, MCP, LSP, checkpointing and knowledge base. Dark-green themed.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": "./lib/startup.js",
    "./runtime": "./lib/runtime/index.js",
    "./commands": "./lib/commands/index.js",
    "./agents": "./lib/agents/index.js",
    "./agents/loader": "./lib/agents/loader.js",
    "./steering": "./lib/steering/index.js",
    "./steering/loader": "./lib/steering/loader.js",
    "./mcp": "./lib/mcp/index.js",
    "./mcp/manager": "./lib/mcp/manager.js",
    "./trust": "./lib/trust/index.js",
    "./trust/store": "./lib/trust/store.js",
    "./lsp": "./lib/lsp/index.js",
    "./checkpoint": "./lib/checkpoint/index.js",
    "./checkpoint/manager": "./lib/checkpoint/manager.js",
    "./knowledge": "./lib/knowledge/index.js",
    "./knowledge/store": "./lib/knowledge/store.js",
    "./tangent": "./lib/tangent/index.js",
    "./theme/palette": "./lib/theme/palette.js",
    "./theme/banner": "./lib/theme/banner.js",
    "./markdown/render": "./lib/markdown/render.js",
    "./utils/shell": "./lib/utils/shell.js",
    "./runtime/session-controller": "./lib/runtime/session-controller.js",
    "./runtime/input": "./lib/runtime/input.js",
    "./runtime/keybindings": "./lib/runtime/keybindings.js",
    "./runtime/types": "./lib/runtime/types.js",
    "./ui/App": "./lib/ui/App.js",
    "./ui/Transcript": "./lib/ui/Transcript.js",
    "./ui/Prompt": "./lib/ui/Prompt.js",
    "./ui/StatusBar": "./lib/ui/StatusBar.js",
    "./ui/Message": "./lib/ui/Message.js",
    "./ui/SlashMenu": "./lib/ui/SlashMenu.js",
    "./ui/Autocomplete": "./lib/ui/Autocomplete.js",
    "./ui/ProgressOverlay": "./lib/ui/ProgressOverlay.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf lib *.tsbuildinfo"
  },
  "dependencies": {
    "@deepseek-ai/dsh-base": "0.1.2-rc.1",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-brand": "0.1.2-rc.1",
    "@deepseek-ai/dsh-cmdline": "0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.1.2-rc.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "cli-highlight": "^2.1.11",
    "fuse.js": "^7.0.0",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "tiktoken": "^1.0.10",
    "vscode-jsonrpc": "^8.2.0",
    "vscode-languageserver-protocol": "^3.17.5",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.5",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damomoashidamomo/dsh-kiro.git"
  },
  "bugs": {
    "url": "https://github.com/damomoashidamomo/dsh-kiro/issues"
  },
  "license": "MIT"
}
